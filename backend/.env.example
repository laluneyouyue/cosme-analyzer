# =============================================================================
# 環境変数のサンプル
# =============================================================================
# このファイルをコピーして .env という名前で保存し、値を埋めてください。
#   cp .env.example .env
# .env は .gitignore で除外されているのでコミットされません。
# =============================================================================

# --- 必須 ---------------------------------------------------------------
# OpenAI APIキー
# https://platform.openai.com/api-keys で取得してください
OPENAI_API_KEY=your_openai_api_key_here


# --- ローカル開発用（任意）----------------------------------------------
# LLMに送ったプロンプトと返答を backend/logs/ に保存するかどうか。
# デバッグしたいときだけ true にします。本番では設定しない（= false）。
SAVE_LLM_LOGS=true


# --- 本番（Render）でだけ設定する ---------------------------------------
# ローカルでは設定しないでください。設定するとローカルからのリクエストが
# 401 で弾かれます（開発サーバーは合言葉ヘッダーを付けないため）。
#
# ALLOWED_ORIGINS: アクセスを許可するフロントエンドのURL（カンマ区切り）
#   例) https://cosme-analyzer.pages.dev
#
# APP_SECRET: Cloudflare 経由のリクエストかを判定する合言葉。
#   Cloudflare Pages 側にも同じ値を登録します。
#   生成方法: python -c "import secrets; print(secrets.token_urlsafe(32))"
